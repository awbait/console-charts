{
  "views": {
    "order": {
      "include": [
        "global",
        "namespace",
        "resourceQuotas",
        "serviceMesh",
        "waypoint/waypoints",
        "subnet/enabled",
        "subnet/subnet"
      ],
      "$comment": "Теги родителя и сабчартов заполняются через global.identity. Назначение namespace общее через global.namespacePurpose. Подсеть включается только после резервирования CIDR.",
      "identity": "/global/namespacePurpose",
      "namespace": {
        "source": "values",
        "pointer": "/global/namespacePurpose",
        "hideOrderField": true
      },
      "overrides": {
        "global": {
          "ui:widget": "edit",
          "ui:view": {
            "include": [
              "namespacePurpose"
            ]
          }
        },
        "serviceMesh": {
          "ui:view": {
            "overrides": {
              "enabled": {
                "ui:widget": "edit"
              },
              "waypoint": {
                "ui:widget": "edit"
              }
            }
          },
          "ui:widget": "edit"
        },
        "waypoint/waypoints": {
          "description": "Укажите прокси, через которые пойдёт трафик сервисов неймспейса. Список используется, только если в этой форме включён переключатель «Подключить прокси для правил доступа». Обычно достаточно одного вейпоинта."
        },
        "subnet/enabled": {
          "ui:widget": "edit",
          "title": "Создавать подсеть"
        },
        "subnet/subnet": {
          "ui:view": {
            "include": [
              "cidrBlock",
              "natOutgoing",
              "excludeIPs",
              "gatewayType",
              "private",
              "allowSubnets"
            ]
          }
        }
      }
    },
    "resources": {
      "include": [
        "resourceQuotas"
      ]
    },
    "serviceMesh": {
      "$comment": "Форма пункта «Действия»: включает сетку и тут же даёт поправить список вейпоинтов, иначе включить вейпоинт можно, а настроить его нечем.",
      "include": [
        "serviceMesh",
        "waypoint/waypoints"
      ],
      "overrides": {
        "serviceMesh": {
          "ui:view": {
            "overrides": {
              "enabled": {
                "ui:widget": "edit"
              },
              "waypoint": {
                "ui:widget": "edit"
              }
            }
          },
          "ui:widget": "edit"
        },
        "waypoint/waypoints": {
          "description": "Укажите прокси, через которые пойдёт трафик сервисов неймспейса. Список используется, только если в этой форме включён переключатель «Подключить прокси для правил доступа». Обычно достаточно одного вейпоинта."
        }
      }
    }
  },
  "defaults": {
    "/namespace/role": "other",
    "/namespace/creator": "console",
    "/namespace/cpaas/cluster": "global",
    "/namespace/cpaas/project": "dev",
    "/global/identity/instance": "id",
    "/global/identity/cluster": "dev",
    "/global/identity/project": "{{.Team}}"
  },
  "actions": [
    {
      "in": "info",
      "view": "resources",
      "label": "Изменить квоты ресурсов"
    },
    {
      "in": "info",
      "view": "serviceMesh",
      "label": "Настроить сервисную сетку"
    }
  ]
}
