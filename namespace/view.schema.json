{
  "views": {
    "order": {
      "include": [
        "namespace",
        "resourceQuotas",
        "serviceMesh"
      ],
      "$comment": "Заказ спрашивает только назначение неймспейса: остальное имя чарт собирает из identity. identity и роль неймспейса в форме скрыты, их проставляет блок defaults.",
      "identity": "/namespace/name",
      "namespace": {
        "source": "values",
        "pointer": "/namespace/name",
        "hideOrderField": true
      },
      "overrides": {
        "serviceMesh": {
          "ui:view": {
            "overrides": {
              "enabled": {
                "ui:widget": "edit"
              }
            }
          },
          "ui:widget": "edit"
        }
      }
    },
    "resources": {
      "include": [
        "resourceQuotas"
      ]
    },
    "serviceMesh": {
      "include": [
        "serviceMesh"
      ],
      "overrides": {
        "serviceMesh": {
          "ui:view": {
            "overrides": {
              "enabled": {
                "ui:widget": "edit"
              }
            }
          },
          "ui:widget": "edit"
        }
      }
    }
  },
  "defaults": {
    "/identity/instance": "ed",
    "/identity/cluster": "dev",
    "/identity/project": "nbox",
    "/namespace/role": "other",
    "/namespace/creator": "console",
    "/waypoint/identity/instance": "ed",
    "/waypoint/identity/cluster": "dev",
    "/waypoint/identity/project": "nbox"
  },
  "actions": [
    {
      "in": "info",
      "view": "resources",
      "label": "Редактировать ресурсы"
    },
    {
      "in": "info",
      "view": "serviceMesh",
      "label": "Вкл/Выкл сервисную сетку"
    }
  ]
}
