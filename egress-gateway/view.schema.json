{
  "tabs": [
    {
      "id": "serviceEntries",
      "form": "serviceEntries",
      "items": "/serviceEntries",
      "title": "Внешние сервисы",
      "addLabel": "Добавить внешний сервис",
      "ui:table": [
        {
          "path": "name",
          "label": "Имя"
        },
        {
          "path": "hostname",
          "label": "Домен"
        }
      ]
    },
    {
      "id": "networkRules",
      "form": "networkPolicies",
      "items": "/networkPolicy/endpoints",
      "title": "Внешние адреса и порты",
      "addLabel": "Добавить адрес",
      "ui:table": [
        {
          "path": "address",
          "label": "Адрес"
        },
        {
          "path": "port",
          "label": "Порт"
        }
      ]
    }
  ],
  "views": {
    "order": {
      "include": [
        "mode",
        "senders",
        "serviceEntries",
        "vpcEgressGateway",
        "networkPolicy",
        "authorizationPolicy",
        "waypointNamespace/waypoint/waypoints"
      ],
      "$comment": "Секции identity в форме нет: теги проставляет блок defaults в global.identity, а назначение namespace гейтвея берёт дефолт схемы. Поле \"waypointNamespace/waypoint/waypoints\" - список вейпоинтов сабчарта waypoint под сабчартом namespace: в нём один элемент, сам egress-гейтвей (имя, namespace отправителей в allowedNamespaces, автомасштабирование). Пути с косой чертой нужны, потому что поля сабчартов иначе не назвать. Секции serviceEntries, networkPolicy и authorizationPolicy имеют смысл только в режиме mesh: в режиме direct чарт останавливает рендер, если они заполнены.",
      "identity": "/vpcEgressGateway/name",
      "overrides": {
        "vpcEgressGateway": {
          "ui:view": {
            "overrides": {
              "name": {
                "ui:readOnly": true
              }
            }
          }
        },
        "waypointNamespace/waypoint/waypoints": {
          "description": "Гейтвей, через который ваши сервисы ходят наружу. Ровно один. В список разрешённых namespace впишите namespace ваших сервисов."
        }
      }
    },
    "egress": {
      "include": [
        "vpcEgressGateway"
      ],
      "overrides": {
        "vpcEgressGateway": {
          "ui:view": {
            "overrides": {
              "name": {
                "ui:readOnly": true
              }
            }
          }
        }
      }
    },
    "waypoint": {
      "$comment": "Правка гейтвея (имя, разрешённые namespace, автомасштабирование, ресурсы) из карточки заказа. Ресурсы скрыты схемой сабчарта, поэтому здесь их нужно раскрыть явно.",
      "include": [
        "waypointNamespace/waypoint/waypoints"
      ],
      "overrides": {
        "waypointNamespace/waypoint/waypoints": {
          "ui:view": {
            "overrides": {
              "name": {
                "ui:readOnly": true
              },
              "resources": {
                "ui:widget": "edit"
              }
            }
          }
        }
      }
    },
    "serviceEntries": {
      "overrides": {
        "name": {
          "ui:readOnly": true
        }
      }
    },
    "networkPolicies": {},
    "authorizationPolicies": {
      "include": [
        "authorizationPolicy"
      ]
    }
  },
  "actions": [
    {
      "in": "info",
      "view": "egress",
      "label": "Редактировать выход"
    },
    {
      "in": "info",
      "view": "waypoint",
      "label": "Редактировать гейтвей"
    },
    {
      "in": "tab:networkRules",
      "view": "authorizationPolicies",
      "label": "Настроить доступ к гейтвею"
    }
  ],
  "defaults": {
    "/global/identity/cluster": "dev",
    "/global/identity/instance": "id",
    "/global/identity/project": "{{.Team}}",
    "/global/namespacePurpose": "egw-eg",
    "/waypointNamespace/namespace/creator": "console",
    "/vegNamespace/namespace/creator": "console"
  }
}
