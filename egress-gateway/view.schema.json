{
  "tabs": [
    {
      "id": "serviceEntries",
      "form": "serviceEntries",
      "items": "/serviceEntries",
      "title": "Внешние сервисы",
      "addLabel": "Добавить внешний сервис",
      "ui:table": [
        {
          "path": "name",
          "label": "Имя сервиса"
        },
        {
          "path": "hostname",
          "label": "Домен или IPv4"
        },
        {
          "path": "port",
          "label": "Порт"
        },
        {
          "path": "protocol",
          "label": "Протокол"
        }
      ],
      "ui:uniqueBy": "name"
    },
    {
      "id": "networkRules",
      "form": "networkPolicies",
      "items": "/networkPolicy/endpoints",
      "title": "Адреса и порты",
      "addLabel": "Добавить адрес и порт",
      "ui:table": [
        {
          "path": "address",
          "label": "Адрес"
        },
        {
          "path": "port",
          "label": "Порт"
        }
      ]
    }
  ],
  "views": {
    "order": {
      "include": [
        "global/identity/cluster",
        "mode",
        "senders",
        "vegNamespace/namespace/name",
        "waypoint",
        "serviceEntries",
        "vpcEgressGateway",
        "networkPolicy",
        "authorizationPolicy"
      ],
      "identity": "/vpcEgressGateway/name",
      "required": [
        "vegNamespace/namespace/name"
      ],
      "overrides": {
        "vpcEgressGateway": {
          "ui:view": {
            "overrides": {
              "name": {
                "ui:readOnly": true
              }
            }
          }
        },
        "vegNamespace/namespace/name": {
          "title": "Назначение неймспейса выхода",
          "ui:widget": "edit",
          "description": "Укажите слово для имени {проект}-{кластер}-ns-veg-vip. Для второго выхода команды в кластере выберите другое."
        }
      }
    },
    "egress": {
      "include": [
        "vpcEgressGateway"
      ],
      "overrides": {
        "vpcEgressGateway": {
          "ui:view": {
            "overrides": {
              "name": {
                "ui:readOnly": true
              }
            }
          }
        }
      }
    },
    "senders": {
      "include": [
        "senders"
      ]
    },
    "serviceEntries": {
      "overrides": {
        "name": {
          "ui:readOnly": true
        }
      }
    },
    "networkPolicies": {},
    "authorizationPolicies": {
      "include": [
        "authorizationPolicy"
      ]
    },
    "waypoint": {
      "include": [
        "waypoint"
      ]
    }
  },
  "actions": [
    {
      "in": "info",
      "view": "egress",
      "label": "Настроить выход"
    },
    {
      "in": "info",
      "view": "senders",
      "label": "Настроить отправителей"
    },
    {
      "in": "info",
      "view": "waypoint",
      "label": "Настроить вейпоинты"
    },
    {
      "in": "tab:networkRules",
      "view": "authorizationPolicies",
      "label": "Настроить доступ к гейтвею"
    }
  ],
  "initial": {
    "/vegNamespace/namespace/name": "veg-vip"
  },
  "defaults": {
    "/global/identity/project": "{{.Team}}",
    "/global/identity/instance": "{{.Vars.INSTANCE}}",
    "/vegNamespace/namespace/creator": "console"
  }
}
