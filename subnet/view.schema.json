  "actions": [
    {
      "in": "info",
      "view": "subnet",
      "label": "Изменить настройки подсети"
    },
    {
      "in": "info",
      "view": "private",
      "label": "Изолирование подсети"
    },
    {
      "in": "info",
      "view": "namespaces",
      "label": "Подключенные неймспейсы"
    },
    {
      "in": "info",
      "view": "allowSubnets",
      "label": "Разрешённые подсети"
    }
  ],
  "initial": {
    "/subnet/name": "app",
    "/identity/cluster": "{{.Vars.CLUSTER}}",
    "/subnet/reservedIps": "0"
  },
  "defaults": {
    "/enabled": "true",
    "/identity/project": "{{.Team}}",
    "/identity/instance": "{{.Vars.INSTANCE}}"
  }
