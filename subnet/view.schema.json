              "mask": {
                "ui:widget": "hidden"
              },
              "name": {
                "ui:widget": "hidden"
              },
              "private": {
                "ui:widget": "edit"
              },
              "namespaces": {
                "ui:widget": "hidden"
              },
              "reservedIps": {
                "ui:widget": "hidden"
              },
              "allowSubnets": {
                "ui:widget": "hidden"
              }
            }
          }
        }
      }
    },
    "namespaces": {
      "include": [
        "subnet"
      ],
      "overrides": {
        "subnet": {
          "ui:view": {
            "overrides": {
              "mask": {
                "ui:widget": "hidden"
              },
              "name": {
                "ui:widget": "hidden"
              },
              "private": {
                "ui:widget": "hidden"
              },
              "namespaces": {
                "ui:widget": "edit",
                "description": "Укажите название неймспейсов, на которые распространяется эта подсеть"
