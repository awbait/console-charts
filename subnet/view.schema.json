{
  "views": {
    "order": {
      "include": [
        "identity/cluster",
        "subnet"
      ],
      "identity": "/subnet/name",
      "overrides": {
        "subnet": {
          "ui:view": {
            "overrides": {
              "name": {
                "description": "Назначение подсети, 2..12 символов. Полное имя составляется по маске {{identity.project}}-{{identity.cluster}}-subnet-{{subnet.name}}",
                "ui:readOnly": true
              },
              "mask": {
                "ui:widget": "hidden"
              },
              "private": {
                "ui:widget": "edit"
              },
              "cidrBlock": {
                "title": "CIDR",
                "ui:widget": "edit"
              },
              "namespaces": {
                "description": "Укажите название неймспейсов, на которые распространяется эта подсеть"
              },
              "allowSubnets": {
                "description": "Укажите CIDR подсетей, с которыми у этой подсети должна быть прямая сетевая связность"
              }
            }
          }
        }
      }
    },
    "subnet": {
      "include": [
        "subnet"
      ],
      "overrides": {
        "subnet": {
          "ui:view": {
            "overrides": {
              "name": {
                "ui:widget": "hidden"
              },
              "mask": {
                "ui:widget": "hidden"
              },
