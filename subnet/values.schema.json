{
  "type": "object",
  "additionalProperties": false,
  "propertyOrder": [
    "identity",
    "enabled",
    "global",
    "generic",
    "subnet",
    "namespaceBinding"
  ],
  "properties": {
    "identity": {
      "$ref": "#/definitions/identity",
      "title": "Окружение и проект",
      "ui:widget": "hidden"
    },
    "enabled": {
      "type": "boolean",
      "title": "Создавать подсеть",
      "ui:widget": "hidden"
    },
    "global": {
      "type": "object",
      "ui:widget": "hidden"
    },
    "generic": {
      "$ref": "#/definitions/generic",
      "ui:widget": "hidden"
    },
    "subnet": {
      "$ref": "#/definitions/subnet",
      "title": "Подсеть"
    },
    "namespaceBinding": {
      "title": "Привязка к namespace",
      "ui:widget": "hidden",
      "$ref": "#/definitions/namespaceBinding"
    }
  },
  "required": [
    "identity",
    "subnet"
  ],
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/subnet/values.schema.json",
  "title": "Subnet Helm chart values",
  "definitions": {
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "propertyOrder": [
        "instance",
        "cluster",
        "project"
      ],
      "properties": {
        "instance": {
          "title": "Инстанс платформы",
          "description": "Выберите инстанс вместе с кластером. Эта пара определяет окружение заказа.",
          "type": "string",
          "enum": [
            "in",
            "id",
            "ed",
            "pr"
          ],
          "enumNames": [
            "Infra-dev-ecpk (in)",
            "dev-ecpk (id)",
            "techsec-dev, dev-common и test-common (ed)",
            "global, observability, techsec, int-common, ML и ext-common (pr)"
          ]
        },
        "cluster": {
          "title": "Кластер",
          "description": "Выберите кластер, в котором будет размещён заказ. Выбирайте его вместе с инстансом.",
          "type": "string",
          "enum": [
            "inf",
            "dev",
            "tco",
            "tst",
            "gl",
            "obs",
            "tcc",
            "cmi",
            "ml",
            "cme"
          ],
          "enumNames": [
            "Infra-dev-ecpk (inf)",
            "dev-ecpk и dev-common (dev)",
            "techsec-dev (tco)",
            "test-common (tst)",
            "global (gl)",
            "observability (obs)",
            "techsec (tcc)",
            "int-common (cmi)",
            "ML (ml)",
            "ext-common (cme)"
          ]
        },
        "project": {
          "title": "Код проекта",
          "description": "Укажите короткий код проекта. Он добавляется в метки, по которым можно найти ресурсы в кластере.",
          "$ref": "#/definitions/projectToken"
        }
      },
      "required": [
        "instance",
        "cluster",
        "project"
      ]
    },
    "generic": {
      "type": "object",
      "additionalProperties": false,
      "propertyOrder": [
        "labels",
        "annotations"
      ],
      "properties": {
        "labels": {
          "title": "Общие метки",
          "description": "Укажите метки для всех создаваемых ресурсов. Они добавляются в metadata.labels.",
          "$ref": "#/definitions/stringMap"
        },
        "annotations": {
          "title": "Общие аннотации",
          "description": "Укажите аннотации для всех создаваемых ресурсов. Они добавляются в metadata.annotations.",
          "$ref": "#/definitions/stringMap"
        }
      }
    },
    "subnet": {
      "type": "object",
      "additionalProperties": false,
      "propertyOrder": [
        "name",
        "mask",
        "reservedIps",
        "allowSubnets",
        "namespaces",
        "cidrBlock",
        "natOutgoing",
        "excludeIPs",
        "gatewayType",
        "gatewayNodes",
        "private",
        "default",
        "protocol",
        "enableEcmp"
      ],
      "properties": {
        "mask": {
          "title": "Маска подсети",
          "description": "Выберите размер подсети по нужному числу подов. Платформа забронирует диапазон с этой маской в Netbox.",
          "type": "integer",
          "enum": [
            29,
            28,
            27,
            26,
            25,
            24
          ],
          "enumNames": [
            "5 подов (/29)",
            "13 подов (/28)",
            "29 подов (/27)",
            "61 под (/26)",
            "125 подов (/25)",
            "253 пода (/24)"
          ]
        },
        "reservedIps": {
          "title": "Количество резервируемых адресов",
          "description": "Укажите, сколько адресов оставить для своих задач, например для точки входа с постоянным адресом. Эти адреса не будут выдаваться сервисам. Платформа выделит их и покажет в карточке неймспейса. Адрес шлюза резервируется всегда, отдельно учитывать его не нужно.",
          "type": "integer",
          "minimum": 0,
          "maximum": 16
        },
        "name": {
          "type": "string",
          "title": "Назначение подсети",
          "maxLength": 12,
          "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
          "description": "2..12 символов. Пусто допускается только при автоматической привязке к namespace."
        },
        "cidrBlock": {
          "type": "string",
          "title": "Диапазон адресов подсети",
          "description": "Диапазон, забронированный в Netbox, вместе с маской, например 10.24.8.0/24. Служебное поле заполняет платформа. В форме скрыто.",
          "ui:widget": "hidden",
          "pattern": "^$|^(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])(?:\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])){3}/(?:1[6-9]|2[0-9]|30)$"
        },
        "natOutgoing": {
          "type": "boolean",
          "title": "NAT исходящего трафика",
          "description": "Включает NAT средствами kube-ovn. Обычно выключен: внешний трафик проходит через шлюз с известным адресом. В форме скрыто.",
          "ui:widget": "hidden"
        },
        "excludeIPs": {
          "type": "array",
          "title": "Исключённые адреса",
          "ui:widget": "hidden",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])(?:\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])){3}(?:\\.\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])(?:\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])){3})?$"
          }
        },
        "gatewayType": {
          "type": "string",
          "title": "Тип шлюза",
          "ui:widget": "hidden",
          "enum": [
            "distributed",
            "centralized"
          ],
          "enumNames": [
            "Распределённый",
            "Централизованный"
          ]
        },
        "gatewayNodes": {
          "type": "string",
          "title": "Узлы шлюза",
          "ui:widget": "hidden"
        },
        "private": {
          "type": "boolean",
          "title": "Изолированная подсеть",
          "description": "Разрешает трафик только в указанные разрешённые подсети. Отключите, если поды сами обращаются к внешним адресам. В форме скрыто.",
          "ui:widget": "hidden"
        },
        "allowSubnets": {
          "type": "array",
          "title": "Разрешённые подсети",
          "description": "Укажите диапазоны адресов подсетей, с которыми нужен сетевой обмен.",
          "uniqueItems": true,
          "items": {
            "title": "Диапазон адресов подсети",
            "type": "string",
            "pattern": "^(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])(?:\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])){3}/(?:[0-9]|[12][0-9]|3[0-2])$"
          }
        },
        "namespaces": {
          "type": "array",
          "title": "Неймспейсы",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 63,
            "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
          }
        },
        "default": {
          "type": "boolean",
          "title": "Подсеть по умолчанию",
          "const": false,
          "ui:widget": "hidden"
        },
        "protocol": {
          "type": "string",
          "title": "Протокол",
          "const": "IPv4",
          "ui:widget": "hidden"
        },
        "enableEcmp": {
          "type": "boolean",
          "title": "ECMP",
          "const": false,
          "ui:widget": "hidden"
        }
      },
      "required": [
        "name",
        "mask",
        "reservedIps",
        "cidrBlock",
        "natOutgoing",
        "excludeIPs",
        "gatewayType",
        "gatewayNodes",
        "private",
        "default",
        "protocol",
        "enableEcmp"
      ]
    },
    "projectToken": {
      "type": "string",
      "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$",
      "minLength": 2,
      "maxLength": 9
    },
    "stringMap": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "namespaceBinding": {
      "type": "object",
      "additionalProperties": false,
      "propertyOrder": [
        "enabled",
        "purpose",
        "namespaceOverride"
      ],
      "required": [
        "enabled",
        "purpose",
        "namespaceOverride"
      ],
      "properties": {
        "enabled": {
          "type": "boolean",
          "title": "Автоматическая привязка"
        },
        "purpose": {
          "type": "string",
          "title": "Назначение namespace",
          "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
          "maxLength": 12
        },
        "namespaceOverride": {
          "type": "string",
          "title": "Полное имя namespace",
          "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
          "maxLength": 63
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "namespaceBinding": {
            "properties": {
              "enabled": {
                "const": false
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "subnet": {
            "properties": {
              "name": {
                "minLength": 2
              }
            }
          }
        }
      }
    },
    {
      "$comment": "An automatic binding names the namespace itself, so an explicit list next to it is refused here instead of at render time.",
      "if": {
        "required": [
          "namespaceBinding"
        ],
        "properties": {
          "namespaceBinding": {
            "required": [
              "enabled"
            ],
            "properties": {
              "enabled": {
                "const": true
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "subnet": {
            "properties": {
              "namespaces": {
                "maxItems": 0
              }
            }
          }
        }
      }
    }
  ]
}
