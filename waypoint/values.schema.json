{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/waypoint/values.schema.json",
  "title": "waypoint Helm chart values",
  "description": "Editor-oriented schema for the waypoint chart (Istio ambient namespace waypoint proxy, Gateway API).",
  "type": "object",
  "additionalProperties": false,
  "propertyOrder": [
    "identity",
    "generic",
    "waypoints"
  ],
  "required": [
    "identity"
  ],
  "properties": {
    "identity": {
      "title": "Окружение и проект",
      "description": "Куда встанет сервис и какому проекту он принадлежит. Задаётся один раз на весь заказ.",
      "$ref": "#/definitions/identity"
    },
    "generic": {
      "title": "Generic settings",
      "description": "Common labels/annotations applied to all chart resources.",
      "ui:widget": "hidden",
      "$ref": "#/definitions/generic"
    },
    "waypoints": {
      "title": "Вейпоинты",
      "description": "Прокси, через которые пойдёт трафик ваших сервисов. Обычно хватает одного.",
      "type": "array",
      "items": {
        "$ref": "#/definitions/waypoint"
      },
      "defaultSnippets": [
        {
          "label": "Вейпоинт",
          "body": [
            {
              "name": "mesh",
              "for": "service"
            }
          ]
        }
      ]
    },
    "global": {
      "title": "Global values",
      "description": "Helm global values, injected automatically when the chart is used as a subchart. Not used by the chart templates.",
      "type": "object",
      "ui:widget": "hidden"
    },
    "enabled": {
      "title": "Enabled",
      "description": "Parent chart condition flag when included as a subchart. Not used by the chart templates.",
      "type": "boolean",
      "ui:widget": "hidden"
    }

  },
  "definitions": {
    "shortToken": {
      "type": "string",
      "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$",
      "minLength": 2,
      "maxLength": 6
    },
    "projectToken": {
      "type": "string",
      "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$",
      "minLength": 2,
      "maxLength": 9
    },
    "tplStringMap": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "propertyOrder": [
        "instance",
        "cluster",
        "project"
      ],
      "properties": {
        "instance": {
          "title": "Инстанс",
          "description": "Выбирайте вместе с кластером: пара инстанс и кластер задаёт окружение.",
          "type": "string",
          "enum": [
            "in",
            "id",
            "ed",
            "pr"
          ],
          "enumNames": [
            "Infra-dev-ecpk (in)",
            "dev-ecpk (id)",
            "techsec-dev, dev-common, test-common (ed)",
            "global, observability, techsec, int-common, ML, ext-common (pr)"
          ]
        },
        "cluster": {
          "title": "Кластер",
          "description": "Кластер, в котором будет работать сервис. Выбирайте вместе с инстансом.",
          "type": "string",
          "enum": [
            "inf",
            "dev",
            "tco",
            "tst",
            "gl",
            "obs",
            "tcc",
            "cmi",
            "ml",
            "cme"
          ],
          "enumNames": [
            "Infra-dev-ecpk (inf)",
            "dev-ecpk и dev-common (dev)",
            "techsec-dev (tco)",
            "test-common (tst)",
            "global (gl)",
            "observability (obs)",
            "techsec (tcc)",
            "int-common (cmi)",
            "ML (ml)",
            "ext-common (cme)"
          ]
        },
        "project": {
          "title": "Проект",
          "description": "Короткий код проекта. Попадает в имена ресурсов и в метки.",
          "$ref": "#/definitions/projectToken"
        }
      },
      "required": [
        "instance",
        "cluster",
        "project"
      ]
    },
    "generic": {
      "type": "object",
      "additionalProperties": false,
      "propertyOrder": [
        "labels",
        "annotations"
      ],
      "properties": {
        "labels": {
          "title": "Common labels",
          "description": "Common labels for all chart resources. Result: metadata.labels.",
          "$ref": "#/definitions/tplStringMap"
        },
        "annotations": {
          "title": "Common annotations",
          "description": "Common annotations for all chart resources. Result: metadata.annotations.",
          "$ref": "#/definitions/tplStringMap"
        }
      }
    },
    "waypoint": {
      "type": "object",
      "additionalProperties": false,
      "propertyOrder": [
        "name",
        "enabled",
        "for"
      ],
      "properties": {
        "name": {
          "title": "Имя вейпоинта",
          "description": "Короткое имя, по которому вы отличите этот вейпоинт от других.",
          "$ref": "#/definitions/shortToken"
        },
        "enabled": {
          "title": "enabled",
          "description": "Set to false to keep the entry in values without creating the Gateway.",
          "type": "boolean",
          "default": true,
          "ui:widget": "hidden"
        },
        "for": {
          "title": "Область перехвата",
          "description": "Какой трафик проходит через waypoint.",
          "type": "string",
          "enum": [
            "service",
            "workload",
            "all"
          ],
          "enumNames": [
            "Трафик к сервисам (service)",
            "Трафик к подам (workload)",
            "И тот, и другой (all)"
          ],
          "default": "service"
        }
      },
      "required": [
        "name"
      ]
    }
  }
}
