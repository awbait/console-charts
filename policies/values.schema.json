{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/policies/values.schema.json",
  "title": "policies Helm chart values",
  "description": "Editor-oriented schema for the policies chart (NetworkPolicy + Istio AuthorizationPolicy). Three independent sections: policies[], netpol[], authzpol[].",
  "type": "object",
  "additionalProperties": false,
  "propertyOrder": [
    "identity",
    "generic",
    "defaults",
    "policies",
    "netpol",
    "authzpol"
  ],
  "required": [
    "identity"
  ],
  "properties": {
    "identity": {
      "title": "Окружение и проект",
      "description": "Куда встанет заказ и к какому проекту он относится. Задаётся один раз на весь заказ.",
      "$ref": "#/definitions/identity"
    },
    "generic": {
      "title": "Generic settings",
      "description": "Common labels/annotations applied to all chart resources.",
      "$ref": "#/definitions/generic",
      "ui:widget": "hidden"
    },
    "defaults": {
      "title": "Значения по умолчанию",
      "description": "Подставляются в правила, где поле оставлено пустым.",
      "$ref": "#/definitions/defaults"
    },
    "policies": {
      "title": "Правила доступа",
      "description": "Опишите связь сервиса с соседями целиком. Соседу заказывать ничего не нужно.",
      "type": "array",
      "items": {
        "$ref": "#/definitions/policy"
      },
      "defaultSnippets": [
        {
          "label": "Правило доступа",
          "body": [
            {
              "name": "core",
              "serviceAccount": "netbox",
              "selector": {
                "app.kubernetes.io/name": "netbox"
              },
              "ingress": [
                {
                  "from": [
                    {
                      "namespace": "netbox-ingress",
                      "selector": {
                        "app.kubernetes.io/name": "ingress-istio"
                      }
                    }
                  ],
                  "ports": [
                    {
                      "port": 8080
                    }
                  ]
                }
              ],
              "egress": [
                {
                  "to": [
                    {
                      "namespace": "netbox-postgresql",
                      "selector": {
                        "app.kubernetes.io/name": "postgresql"
                      }
                    }
                  ],
                  "ports": [
                    {
                      "port": 5432
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    "netpol": {
      "title": "Правила сетевого уровня",
      "description": "Берите, когда нужен только сетевой уровень или правило по диапазону адресов.",
      "type": "array",
      "items": {
        "$ref": "#/definitions/netpol"
      },
      "defaultSnippets": [
        {
          "label": "Правило сетевого уровня",
          "body": [
            {
              "name": "ing",
              "selector": {
                "app.kubernetes.io/name": "ingress-istio"
              },
              "ingress": [
                {
                  "from": [
                    {
                      "ipBlock": {
                        "cidr": "0.0.0.0/0"
                      }
                    }
                  ],
                  "ports": [
                    {
                      "port": 443
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    "authzpol": {
      "title": "Правила сервисной сети",
      "description": "Берите, когда сетевые правила заданы другим способом.",
      "type": "array",
      "items": {
        "$ref": "#/definitions/authzpol"
      },
      "defaultSnippets": [
        {
          "label": "Правило сервисной сети",
          "body": [
            {
              "name": "gate",
              "action": "ALLOW",
              "selector": {
                "app.kubernetes.io/name": "ingress-istio"
              },
              "rules": [
                {
                  "from": {
                    "ipBlocks": [
                      "0.0.0.0/0"
                    ]
                  },
                  "ports": [
                    {
                      "port": 443
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  },
  "definitions": {
    "k8sName": {
      "type": "string",
      "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
    },
    "shortToken": {
      "type": "string",
      "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$",
      "minLength": 2,
      "maxLength": 6
    },
    "projectToken": {
      "type": "string",
      "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$",
      "minLength": 2,
      "maxLength": 9
    },
    "port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "stringMap": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "tplStringMap": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "generic": {
      "type": "object",
      "additionalProperties": false,
      "propertyOrder": [
        "labels",
        "annotations"
      ],
      "properties": {
        "labels": {
          "title": "Common labels",
          "description": "Common labels for all chart resources. Result: metadata.labels.",
          "$ref": "#/definitions/tplStringMap"
        },
        "annotations": {
          "title": "Common annotations",
          "description": "Common annotations for all chart resources. Result: metadata.annotations.",
          "$ref": "#/definitions/tplStringMap"
        }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "propertyOrder": [
        "instance",
        "cluster",
        "project"
      ],
      "properties": {
        "instance": {
          "title": "Инстанс",
          "description": "Выбирайте вместе с кластером: пара инстанс и кластер задаёт окружение.",
          "type": "string",
          "enum": [
            "in",
            "id",
            "ed",
            "pr"
          ],
          "enumNames": [
            "Infra-dev-ecpk (in)",
            "dev-ecpk (id)",
            "techsec-dev, dev-common, test-common (ed)",
            "global, observability, techsec, int-common, ML, ext-common (pr)"
          ]
        },
        "cluster": {
          "title": "Кластер",
          "description": "Кластер, в котором будет работать сервис. Выбирайте вместе с инстансом.",
          "type": "string",
          "enum": [
            "inf",
            "dev",
            "tco",
            "tst",
            "gl",
            "obs",
            "tcc",
            "cmi",
            "ml",
            "cme"
          ],
          "enumNames": [
            "Infra-dev-ecpk (inf)",
            "dev-ecpk и dev-common (dev)",
            "techsec-dev (tco)",
            "test-common (tst)",
            "global (gl)",
            "observability (obs)",
            "techsec (tcc)",
            "int-common (cmi)",
            "ML (ml)",
            "ext-common (cme)"
          ]
        },
        "project": {
          "title": "Проект",
          "description": "Короткий код проекта. Попадает в имена ресурсов и в метки.",
          "$ref": "#/definitions/projectToken"
        }
      },
      "required": [
        "instance",
        "cluster",
        "project"
      ]
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "propertyOrder": [
        "trustDomain",
        "namespaceLabelKey",
        "protocol"
      ],
      "properties": {
        "trustDomain": {
          "title": "trustDomain",
          "description": "Istio trust domain for the principal: {trustDomain}/ns/{namespace}/sa/{serviceAccount}.",
          "type": "string",
          "default": "cluster.local",
          "ui:widget": "hidden"
        },
        "namespaceLabelKey": {
          "title": "namespaceLabelKey",
          "description": "Namespace label key for the NetworkPolicy namespaceSelector.",
          "type": "string",
          "default": "kubernetes.io/metadata.name",
          "ui:widget": "hidden"
        },
        "protocol": {
          "title": "Протокол по умолчанию",
          "description": "Берётся для портов, где протокол не выбран.",
          "type": "string",
          "enum": [
            "TCP",
            "UDP",
            "SCTP"
          ],
          "default": "TCP"
        }
      }
    },
    "portEntry": {
      "type": "object",
      "additionalProperties": false,
      "propertyOrder": [
        "port",
        "protocol"
      ],
      "properties": {
        "port": {
          "title": "Порт",
          "description": "Порт получателя.",
          "$ref": "#/definitions/port"
        },
        "protocol": {
          "title": "Протокол",
          "description": "Пустое поле - берётся протокол из общих настроек.",
          "type": "string",
          "enum": [
            "TCP",
            "UDP",
            "SCTP"
          ],
          "default": "TCP"
        }
      },
      "required": [
        "port"
      ]
    },
    "ipBlock": {
      "type": "object",
      "additionalProperties": false,
      "propertyOrder": [
        "cidr",
        "except"
      ],
      "properties": {
        "cidr": {
          "title": "cidr",
          "description": "CIDR block.",
          "type": "string"
        },
        "except": {
          "title": "except",
          "description": "Exclusions from the CIDR block.",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "cidr"
      ]
    },
    "labelSelector": {
      "type": "object",
      "additionalProperties": false,
      "propertyOrder": [
        "matchLabels",
        "matchExpressions"
      ],
      "properties": {
        "matchLabels": {
          "title": "matchLabels",
          "$ref": "#/definitions/stringMap"
        },
        "matchExpressions": {
          "title": "matchExpressions",
          "type": "array",
          "items": {
            "$ref": "#/definitions/labelSelectorRequirement"
          }
        }
      }
    },
    "labelSelectorRequirement": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string"
        },
        "operator": {
          "type": "string",
          "enum": [
            "In",
            "NotIn",
            "Exists",
            "DoesNotExist"
          ],
          "enumNames": [
            "Одно из значений (In)",
            "Кроме значений (NotIn)",
            "Метка есть (Exists)",
            "Метки нет (DoesNotExist)"
          ]
        },
        "values": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "key",
        "operator"
      ]
    },
    "policyIngressPeer": {
      "type": "object",
      "additionalProperties": false,
      "description": "Откуда приходит трафик.",
      "propertyOrder": [
        "namespace",
        "selector",
        "serviceAccount",
        "ipBlock",
        "namespaceSelector",
        "podSelector"
      ],
      "properties": {
        "namespace": {
          "title": "Неймспейс",
          "$ref": "#/definitions/k8sName",
          "description": "Неймспейс, из которого ходят к вам."
        },
        "selector": {
          "title": "Метки подов",
          "description": "Чьи поды пускаем. Пустое поле - весь неймспейс.",
          "$ref": "#/definitions/stringMap"
        },
        "serviceAccount": {
          "title": "Сервисный аккаунт отправителя",
          "description": "Укажите, чтобы разрешить доступ конкретному приложению. Пустое поле разрешает доступ всему неймспейсу.",
          "$ref": "#/definitions/k8sName"
        },
        "ipBlock": {
          "title": "ipBlock",
          "ui:widget": "hidden",
          "$ref": "#/definitions/ipBlock"
        },
        "namespaceSelector": {
          "title": "namespaceSelector",
          "ui:widget": "hidden",
          "$ref": "#/definitions/labelSelector"
        },
        "podSelector": {
          "title": "podSelector",
          "ui:widget": "hidden",
          "$ref": "#/definitions/labelSelector"
        }
      }
    },
    "policyEgressPeer": {
      "type": "object",
      "additionalProperties": false,
      "description": "Куда ходит ваш сервис.",
      "propertyOrder": [
        "namespace",
        "selector",
        "ipBlock"
      ],
      "properties": {
        "namespace": {
          "title": "Неймспейс",
          "$ref": "#/definitions/k8sName",
          "description": "Неймспейс, в который вы ходите."
        },
        "selector": {
          "title": "Метки подов",
          "description": "К чьим подам ходим. Пустое поле - весь неймспейс.",
          "$ref": "#/definitions/stringMap"
        },
        "ipBlock": {
          "title": "ipBlock",
          "ui:widget": "hidden",
          "$ref": "#/definitions/ipBlock"
        }
      }
    },
    "netpolPeer": {
      "type": "object",
      "additionalProperties": false,
      "description": "Вторая сторона правила.",
      "propertyOrder": [
        "namespace",
        "selector",
        "ipBlock",
        "namespaceSelector",
        "podSelector"
      ],
      "properties": {
        "namespace": {
          "title": "Неймспейс",
          "$ref": "#/definitions/k8sName",
          "description": "Неймспейс второй стороны."
        },
        "selector": {
          "title": "Метки подов",
          "$ref": "#/definitions/stringMap",
          "description": "Чьи поды. Пустое поле - весь неймспейс."
        },
        "ipBlock": {
          "title": "ipBlock",
          "ui:widget": "hidden",
          "$ref": "#/definitions/ipBlock"
        },
        "namespaceSelector": {
          "title": "namespaceSelector",
          "ui:widget": "hidden",
          "$ref": "#/definitions/labelSelector"
        },
        "podSelector": {
          "title": "podSelector",
          "ui:widget": "hidden",
          "$ref": "#/definitions/labelSelector"
        }
      }
    },
    "policyIngressRule": {
      "type": "object",
      "additionalProperties": false,
      "propertyOrder": [
        "from",
        "ports"
      ],
      "properties": {
        "from": {
          "title": "Источники",
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/policyIngressPeer"
          },
          "description": "Нужен хотя бы один."
        },
        "ports": {
          "title": "Порты",
          "type": "array",
          "items": {
            "$ref": "#/definitions/portEntry"
          },
          "description": "Пустой список - любые порты."
        }
      },
      "required": [
        "from"
      ]
    },
    "policyEgressRule": {
      "type": "object",
      "additionalProperties": false,
      "propertyOrder": [
        "to",
        "ports"
      ],
      "properties": {
        "to": {
          "title": "Получатели",
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/policyEgressPeer"
          },
          "description": "Нужен хотя бы один."
        },
        "ports": {
          "title": "Порты",
          "type": "array",
          "items": {
            "$ref": "#/definitions/portEntry"
          },
          "description": "Пустой список - любые порты."
        }
      },
      "required": [
        "to"
      ]
    },
    "netpolIngressRule": {
      "type": "object",
      "additionalProperties": false,
      "propertyOrder": [
        "from",
        "ports"
      ],
      "properties": {
        "from": {
          "title": "Источники",
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/netpolPeer"
          },
          "description": "Нужен хотя бы один."
        },
        "ports": {
          "title": "Порты",
          "type": "array",
          "items": {
            "$ref": "#/definitions/portEntry"
          },
          "description": "Пустой список - любые порты."
        }
      },
      "required": [
        "from"
      ]
    },
    "netpolEgressRule": {
      "type": "object",
      "additionalProperties": false,
      "propertyOrder": [
        "to",
        "ports"
      ],
      "properties": {
        "to": {
          "title": "Получатели",
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/netpolPeer"
          },
          "description": "Нужен хотя бы один."
        },
        "ports": {
          "title": "Порты",
          "type": "array",
          "items": {
            "$ref": "#/definitions/portEntry"
          },
          "description": "Пустой список - любые порты."
        }
      },
      "required": [
        "to"
      ]
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "propertyOrder": [
        "name",
        "enabled",
        "serviceAccount",
        "selector",
        "ingress",
        "egress"
      ],
      "properties": {
        "name": {
          "title": "Имя правила",
          "description": "Короткое имя, по которому вы отличите это правило от других.",
          "$ref": "#/definitions/shortToken"
        },
        "enabled": {
          "title": "enabled",
          "description": "Set to false to keep the entry in values without creating anything from it.",
          "type": "boolean",
          "default": true,
          "ui:widget": "hidden"
        },
        "serviceAccount": {
          "title": "Сервисный аккаунт вашего сервиса",
          "description": "Под каким аккаунтом работает сервис. Нужен, если есть исходящие правила.",
          "$ref": "#/definitions/k8sName"
        },
        "selector": {
          "title": "Метки подов",
          "description": "По каким меткам находится ваш сервис.",
          "$ref": "#/definitions/stringMap"
        },
        "ingress": {
          "title": "Входящие",
          "description": "Кто может обращаться к вашему сервису.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/policyIngressRule"
          }
        },
        "egress": {
          "title": "Исходящие",
          "description": "Куда вашему сервису разрешено ходить.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/policyEgressRule"
          }
        }
      },
      "required": [
        "name",
        "selector"
      ]
    },
    "netpol": {
      "type": "object",
      "additionalProperties": false,
      "propertyOrder": [
        "name",
        "enabled",
        "selector",
        "ingress",
        "egress"
      ],
      "properties": {
        "name": {
          "title": "Имя правила",
          "description": "Короткое имя, по которому вы отличите это правило от других.",
          "$ref": "#/definitions/shortToken"
        },
        "enabled": {
          "title": "enabled",
          "type": "boolean",
          "default": true,
          "description": "Set to false to keep the entry in values without creating anything from it.",
          "ui:widget": "hidden"
        },
        "selector": {
          "title": "Метки подов",
          "description": "К чьим подам применяется правило. Пустое поле - ко всем в неймспейсе.",
          "$ref": "#/definitions/stringMap"
        },
        "ingress": {
          "title": "Входящие",
          "type": "array",
          "items": {
            "$ref": "#/definitions/netpolIngressRule"
          },
          "description": "Кто может обращаться к этим подам."
        },
        "egress": {
          "title": "Исходящие",
          "type": "array",
          "items": {
            "$ref": "#/definitions/netpolEgressRule"
          },
          "description": "Куда этим подам разрешено ходить."
        }
      },
      "required": [
        "name"
      ]
    },
    "authzpol": {
      "type": "object",
      "additionalProperties": false,
      "propertyOrder": [
        "name",
        "enabled",
        "action",
        "selector",
        "rules"
      ],
      "properties": {
        "name": {
          "title": "Имя правила",
          "description": "Короткое имя, по которому вы отличите это правило от других.",
          "$ref": "#/definitions/shortToken"
        },
        "enabled": {
          "title": "enabled",
          "type": "boolean",
          "default": true,
          "description": "Set to false to keep the entry in values without creating anything from it.",
          "ui:widget": "hidden"
        },
        "action": {
          "title": "Что делать с запросом",
          "description": "Решение, которое правило принимает по подходящему запросу.",
          "type": "string",
          "enum": [
            "ALLOW",
            "DENY",
            "AUDIT",
            "CUSTOM"
          ],
          "enumNames": [
            "Пропустить (ALLOW)",
            "Отклонить (DENY)",
            "Только записать в журнал (AUDIT)",
            "Отдать внешнему обработчику (CUSTOM)"
          ],
          "default": "ALLOW"
        },
        "selector": {
          "title": "Метки подов",
          "description": "К чьим подам применяется правило. Пустое поле - ко всем в неймспейсе.",
          "$ref": "#/definitions/stringMap"
        },
        "rules": {
          "title": "Правила",
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/authzRule"
          },
          "description": "Нужно хотя бы одно."
        }
      },
      "required": [
        "name",
        "rules"
      ]
    },
    "authzRule": {
      "type": "object",
      "additionalProperties": false,
      "propertyOrder": [
        "from",
        "ports",
        "when"
      ],
      "properties": {
        "from": {
          "title": "Кому разрешаем",
          "description": "Заполните хотя бы одну строку ниже.",
          "$ref": "#/definitions/authzSource"
        },
        "ports": {
          "title": "Порты",
          "description": "Пустой список - любые порты.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/portEntry"
          }
        },
        "when": {
          "title": "Дополнительные условия",
          "$ref": "#/definitions/authzWhen",
          "description": "Сужают правило поверх источника."
        }
      }
    },
    "authzSource": {
      "type": "object",
      "additionalProperties": false,
      "description": "Заполните хотя бы одно поле.",
      "propertyOrder": [
        "serviceAccounts",
        "principals",
        "ipBlocks",
        "namespaces"
      ],
      "properties": {
        "serviceAccounts": {
          "title": "Сервисные аккаунты",
          "description": "Разрешает доступ конкретным приложениям.",
          "type": "array",
          "items": {
            "type": "object",
