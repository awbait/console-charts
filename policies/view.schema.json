  "graph": {
    "profile": "policies"
  },
  "views": {
    "base": {
      "$comment": "Пункт «Настройки» на карточке: под каким аккаунтом работает сервис, по каким меткам он находится и какой протокол подставлять портам без протокола.",
      "include": [
        "policies",
        "defaults"
      ],
      "overrides": {
        "policies": {
          "title": "Настройки сервиса",
          "ui:view": {
            "exclude": [
              "enabled",
              "ingress",
              "egress",
              "name"
            ]
          },
          "ui:widget": "single",
          "description": "Под каким аккаунтом работает ваш сервис и по каким меткам он находится."
        }
      }
    },
    "order": {
      "$comment": "Заказ: одно правило доступа с входящими и исходящими. Теги окружения и проекта проставляет блок defaults, проект берётся из команды заказа. Правила сетевого уровня и сервисной сети в заказе не спрашиваются: их заводят потом на своих вкладках.",
      "include": [
        "policies"
      ],
      "identity": "/policies/0/name",
      "overrides": {
        "policies": {
          "title": "Правило доступа",
          "ui:view": {
            "exclude": [
              "enabled"
            ],
            "overrides": {
              "name": {
                "ui:readOnly": true
              },
              "egress": {
                "ui:view": {
                  "overrides": {
                    "to": {
                      "title": "Получатели",
                      "ui:widget": "single"
                    }
                  }
                }
              },
              "ingress": {
                "ui:view": {
                  "overrides": {
                    "from": {
                      "title": "Источники",
                      "ui:widget": "single"
                    }
                  }
                }
              }
            }
          },
          "ui:widget": "single"
        }
      }
    },
    "egress": {
      "overrides": {
        "to": {
          "title": "Получатели",
          "ui:widget": "single"
        }
      }
    },
    "ingress": {
      "overrides": {
        "from": {
          "title": "Источники",
          "ui:widget": "single"
        }
      }
    },
    "netpol": {
      "$comment": "Форма правила сетевого уровня: берут, когда правило нужно только на сетевом уровне или по диапазону адресов. Описывает элемент списка netpol.",
      "overrides": {
        "ingress": {
          "ui:view": {
            "overrides": {
              "from": {
                "title": "Источники",
                "ui:widget": "single"
              }
            }
          }
        },
        "egress": {
          "ui:view": {
            "overrides": {
              "to": {
                "title": "Получатели",
                "ui:widget": "single"
              }
            }
          }
        }
      }
    },
    "authzpol": {
      "$comment": "Форма правила сервисной сети: берут, когда сетевые правила заданы другим способом. Описывает элемент списка authzpol."
    }
  },
  "actions": [
    {
      "in": "info",
      "view": "base",
      "label": "Настройки"
    }
  ],
